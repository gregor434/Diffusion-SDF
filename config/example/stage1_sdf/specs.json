{
  "Description": "COD-VAE SDF reconstruction on the couch example",
  "DataSource": "data",
  "TrainSplit": "data/splits/couch_all.json",
  "ValSplit": "data/splits/couch_all.json",
  "TestSplit": "data/splits/couch_all.json",
  "ModulationSplit": "data/splits/couch_all.json",
  "num_epochs": 100001,
  "log_freq": 5000,
  "training_task": "modulation",
  "stage1_mode": "train_from_scratch",
  "CODVaeSpecs": {
    "strict_checkpoint_loading": true,
    "latent_tokens": 32,
    "latent_dimension": 32,
    "embed_dimension": 512,
    "triplane_dimension": 32,
    "latent_decoder_layers": 12,
    "disable_uncertainty_pruning": true,
    "encoder_params": {
      "num_patches": 512,
      "num_blocks": 4,
      "num_layers_per_block": 3
    },
    "decoder_params": {
      "output_resolution": 128,
      "output_patch_size": 8,
      "num_layers": 12,
      "num_init_layers": 1,
      "mlp_ratio": 2,
      "keep_ratio": 1,
      "num_merged_tokens": 8,
      "use_conv_refine": false
    }
  },
  "SdfModelSpecs": {
    "hidden_dim": 512,
    "feature_dim": 32
  },
  "SurfacePointCount": 2048,
  "SampPerMesh": 16000,
  "NearSurfaceRatio": 0.7,
  "sdf_loss": {
    "type": "l1"
  },
  "loss_weights": {
    "sdf": 1,
    "kl": 0.001,
    "cod_aux": 0
  },
  "learning_rates": {
    "point_encoder": 0.00001,
    "variational_block": 0.00001,
    "latent_decoder": 0.00001,
    "triplane_decoder": 0.00001,
    "sdf_network": 0.0001
  }
}
