{
  "Description": "COD token EDM diffusion (unconditional) on couch example",
  "TrainSplit": "data/splits/couch_all.json",
  "TestSplit": "data/splits/couch_all.json",
  "data_path": "config/example/stage1_sdf/modulations",
  "modulation_ckpt_path": "config/example/stage1_sdf/last.ckpt",
  "num_epochs": 50001,
  "log_freq": 5000,
  "training_task": "diffusion",
  "latent_stats_path": "config/example/stage1_sdf/modulations/latent_stats.npz",
  "diffusion_specs": {
    "sigma_data": 1,
    "P_mean": -1.2,
    "P_std": 1.2,
    "sigma_min": 0.002,
    "sigma_max": 80,
    "rho": 7,
    "sampling_steps": 18
  },
  "diffusion_model_specs": {
    "latent_tokens": 32,
    "latent_dimension": 32,
    "width": 512,
    "depth": 12,
    "heads": 8,
    "mlp_ratio": 4,
    "dropout": 0,
    "cond": false
  },
  "learning_rates": {
    "diffusion": 0.00001
  }
}
