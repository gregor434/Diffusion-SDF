{
  "Description": "Chair objects stage 1 train and val split training",
  "DataSource": "datasets",
  "TrainSplit": "datasets/splits/abo_CHAIR_train.json",
  "ValSplit": "datasets/splits/abo_CHAIR_val.json",
  "TestSplit": "datasets/splits/abo_CHAIR_train.json",
  "ModulationSplit": "datasets/splits/abo_CHAIR_all.json",
  "num_epochs": 10000,
  "log_freq": 500,
  "training_task": "modulation",
  "stage1_mode": "sdf_head_only",
  "CODVaeSpecs": {
    "strict_checkpoint_loading": true,
    "latent_tokens": 32,
    "latent_dimension": 32,
    "embed_dimension": 512,
    "triplane_dimension": 32,
    "latent_decoder_layers": 12,
    "uncertainty_mode": "full_sdf",
    "encoder_params": {
      "num_patches": 512,
      "num_blocks": 4,
      "num_layers_per_block": 3
    },
    "decoder_params": {
      "output_resolution": 128,
      "output_patch_size": 8,
      "num_layers": 12,
      "num_init_layers": 1,
      "mlp_ratio": 2,
      "keep_ratio": 1,
      "num_merged_tokens": 8,
      "use_conv_refine": false
    },
    "checkpoint_path": "tmp/cod_vae_m32_weights.pt"
  },
  "SdfModelSpecs": {
    "hidden_dim": 512,
    "feature_dim": 32
  },
  "SurfacePointCount": 2048,
  "SampPerMesh": 16000,
  "NearSurfaceRatio": 0.7,
  "sdf_loss": {
    "type": "l1"
  },
  "loss_weights": {
    "sdf": 1,
    "kl": 0.001,
    "cod_aux": 0
  },
  "learning_rates": {
    "sdf_network": 0.0001
  }
}
