{
  "Description" : "diffusion training with image conditioning on the ABO chair dataset",
  "TrainSplit" : "datasets/splits/overfit_one_chiar.json",
  "ValSplit" : "datasets/splits/overfit_one_chiar.json",
  "TestSplit" : "datasets/splits/overfit_one_chair.json",
  "data_path" : "config/abo/stage1_sdf/modulations",

  "training_task": "diffusion",

  "conditioning" : {
    "type" : "image",
    "path" : "datasets/ABO/images_filtered",
    "clip_model" : "ViT-B/32"
  },

  "num_epochs" : 1000,
  "log_freq" : 5000,

  "diff_lr" : 1e-5,

  "diffusion_specs" : {
    "timesteps" : 1000,
    "objective" : "pred_x0",
    "loss_type" : "l2"
  },
  "diffusion_model_specs": {
    "dim" : 768,
    "dim_in_out" : 768,
    "depth" : 4,
    "ff_dropout" : 0.3,
    "cond" : true,
    "cross_attn" : true,
    "cond_dropout": true,
    "condition_dim" : 128,
    "condition_encoders": [
      {"type": "image"}
    ]
  }
}
