{
  "Description": "COD token EDM diffusion with image conditioning on ABO chairs",
  "TrainSplit": "datasets/splits/abo_CHAIR_train.json",
  "ValSplit": "datasets/splits/abo_CHAIR_val.json",
  "TestSplit": "datasets/splits/abo_CHAIR_val.json",
  "data_path": "config/abo/stage1_sdf/modulations",
  "modulation_ckpt_path": "config/abo/stage1_sdf/last.ckpt",
  "conditioning": {
    "type": "image",
    "path": "datasets/ABO/images_filtered",
    "clip_model": "ViT-B/32"
  },
  "num_epochs": 1000,
  "log_freq": 5000,
  "training_task": "diffusion",
  "latent_stats_path": "config/abo/stage1_sdf/modulations/latent_stats.npz",
  "diffusion_specs": {
    "sigma_data": 1,
    "P_mean": -1.2,
    "P_std": 1.2,
    "sigma_min": 0.002,
    "sigma_max": 80,
    "rho": 7,
    "sampling_steps": 18
  },
  "diffusion_model_specs": {
    "latent_tokens": 32,
    "latent_dimension": 32,
    "width": 512,
    "depth": 12,
    "heads": 8,
    "mlp_ratio": 4,
    "dropout": 0,
    "cond": true,
    "condition_dim": 128,
    "condition_encoders": [
      {
        "type": "image"
      }
    ]
  },
  "learning_rates": {
    "diffusion": 0.00001
  }
}
