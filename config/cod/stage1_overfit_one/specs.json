{
  "Description": "Diagnostic: overfit the SDF head on one ABO chair with frozen pretrained COD-VAE",
  "DataSource": "datasets",
  "TrainSplit": "datasets/splits/abo_CHAIR_one.json",
  "TestSplit": "datasets/splits/abo_CHAIR_one.json",
  "ModulationSplit": "datasets/splits/abo_CHAIR_one.json",
  "training_task": "modulation",
  "stage1_mode": "sdf_head_only",
  "sample_posterior": false,
  "CODVaeSpecs": {
    "checkpoint_path": "tmp/cod_vae_m32_weights.pt",
    "strict_checkpoint_loading": true,
    "latent_tokens": 32,
    "latent_dimension": 32,
    "embed_dimension": 512,
    "triplane_dimension": 32,
    "latent_decoder_layers": 12,
    "uncertainty_mode": "occupancy_pruning",
    "encoder_params": {"num_patches": 512, "num_blocks": 4, "num_layers_per_block": 3},
    "decoder_params": {
      "output_resolution": 128, "output_patch_size": 8, "num_layers": 12,
      "num_init_layers": 1, "mlp_ratio": 2, "keep_ratio": 0.25,
      "num_merged_tokens": 8, "use_conv_refine": false
    }
  },
  "SdfModelSpecs": {"hidden_dim": 512, "feature_dim": 32},
  "SurfacePointCount": 2048,
  "SampPerMesh": 8192,
  "ValidationSamplesPerMesh": 8192,
  "NearSurfaceRatio": 0.5,
  "sdf_loss": {"type": "huber", "huber_delta": 0.01},
  "loss_weights": {"sdf": 1.0, "kl": 0.0, "cod_aux": 0.0},
  "learning_rates": {
    "sdf_network": 0.0001
  },
  "weight_decay": 0.0,
  "num_epochs": 5000,
  "log_freq": 200,
  "log_every_n_steps": 1
}
