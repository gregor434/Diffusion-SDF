{
  "Description": "Stage three full COD, SDF, and diffusion joint fine-tuning",
  "DataSource": "datasets",
  "TrainSplit": "datasets/splits/abo_CHAIR_train.json",
  "ValSplit": "datasets/splits/abo_CHAIR_val.json",
  "TestSplit": "datasets/splits/abo_CHAIR_val.json",
  "modulation_path": "config/cod/stage1_decoder_finetune/modulations",
  "modulation_ckpt_path": "config/cod/stage1_decoder_finetune/last.ckpt",
  "diffusion_ckpt_path": "config/cod/stage2_transformer_diffusion/last.ckpt",
  "latent_stats_path": "config/cod/stage1_decoder_finetune/modulations/latent_stats.npz",
  "training_task": "combined",
  "stage3_mode": "full_joint_finetune",
  "CODVaeSpecs": {
    "checkpoint_path": "tmp/cod_vae_m32_weights.pt",
    "strict_checkpoint_loading": true,
    "latent_tokens": 32,
    "latent_dimension": 32,
    "embed_dimension": 512,
    "triplane_dimension": 32,
    "latent_decoder_layers": 12,
    "uncertainty_mode": "disabled",
    "encoder_params": {"num_patches": 512, "num_blocks": 4, "num_layers_per_block": 3},
    "decoder_params": {
      "output_resolution": 128, "output_patch_size": 8, "num_layers": 12,
      "num_init_layers": 1, "mlp_ratio": 2, "keep_ratio": 1.0,
      "num_merged_tokens": 8, "use_conv_refine": false
    }
  },
  "SdfModelSpecs": {"hidden_dim": 512, "feature_dim": 32},
  "SurfacePointCount": 2048,
  "SampPerMesh": 8192,
  "NearSurfaceRatio": 0.5,
  "sdf_loss": {"type": "huber", "huber_delta": 0.01},
  "diffusion_specs": {
    "sigma_data": 1.0, "P_mean": -1.2, "P_std": 1.2,
    "sigma_min": 0.002, "sigma_max": 80.0, "rho": 7.0, "sampling_steps": 18
  },
  "diffusion_model_specs": {
    "latent_tokens": 32, "latent_dimension": 32, "width": 512,
    "depth": 12, "heads": 8, "mlp_ratio": 4, "dropout": 0.0, "cond": false
  },
  "loss_weights": {"direct": 1.0, "diffusion": 1.0, "generated": 1.0, "kl": 0.001},
  "learning_rates": {
    "point_encoder": 0.000001,
    "variational_block": 0.000001,
    "latent_decoder": 0.000005,
    "triplane_decoder": 0.000005,
    "sdf_network": 0.00001,
    "diffusion": 0.00001
  },
  "num_epochs": 500,
  "log_freq": 25
}
