{
  "Description": "Stage one fine-tuning COD decoders and the SDF head",
  "DataSource": "datasets",
  "TrainSplit": "datasets/splits/abo_CHAIR_train.json",
  "ValSplit": "datasets/splits/abo_CHAIR_val.json",
  "TestSplit": "datasets/splits/abo_CHAIR_val.json",
  "ModulationSplit": "datasets/splits/abo_CHAIR_all.json",
  "training_task": "modulation",
  "stage1_mode": "cod_decoder_finetune",
  "sample_posterior": true,
  "CODVaeSpecs": {
    "checkpoint_path": "tmp/cod_vae_m32_weights.pt",
    "strict_checkpoint_loading": true,
    "latent_tokens": 32,
    "latent_dimension": 32,
    "embed_dimension": 512,
    "triplane_dimension": 32,
    "latent_decoder_layers": 12,
    "uncertainty_mode": "disabled",
    "encoder_params": {"num_patches": 512, "num_blocks": 4, "num_layers_per_block": 3},
    "decoder_params": {
      "output_resolution": 128, "output_patch_size": 8, "num_layers": 12,
      "num_init_layers": 1, "mlp_ratio": 2, "keep_ratio": 1.0,
      "num_merged_tokens": 8, "use_conv_refine": false
    }
  },
  "SdfModelSpecs": {"hidden_dim": 512, "feature_dim": 32},
  "SurfacePointCount": 2048,
  "SampPerMesh": 16000,
  "NearSurfaceRatio": 0.7,
  "sdf_loss": {"type": "truncated_sdf", "truncation": 0.1},
  "loss_weights": {
    "sdf": 1.0,
    "sdf_initial": 0.0,
    "cod_aux": 1.0,
    "uncertainty": 0.0,
    "surface_zero": 0.0,
    "eikonal": 0.0,
    "normal": 0.0,
    "kl": 0.0
  },
  "learning_rates": {
    "latent_decoder": 0.00001,
    "triplane_decoder": 0.00001,
    "sdf_network": 0.0001
  },
  "weight_decay": 0.0,
  "gradient_clip_val": 0.5,
  "num_epochs": 10000,
  "log_freq": 100,
  "log_every_n_steps": 10
}
