{
  "Description": "Slot-aware medium unconditional diffusion warm-started on reconstruction-preserving learned-query encoder-refined latents",
  "DataSource": "datasets",
  "TrainSplit": "datasets/splits/abo_fullchairs_multiray21_CHAIR_train.json",
  "ValSplit": "datasets/splits/abo_fullchairs_multiray21_CHAIR_val.json",
  "TestSplit": "datasets/splits/abo_fullchairs_multiray21_CHAIR_val.json",
  "modulation_ckpt_path": "config/cod/stage1_learned_query_encoder_refinement_multiray21/best.ckpt",
  "modulation_cache_path": "config/cod/stage2_transformer_diffusion_multiray21_learned_query/modulations",
  "data_path": "config/cod/stage2_transformer_diffusion_multiray21_learned_query/modulations",
  "latent_stats_path": "config/cod/stage2_transformer_diffusion_multiray21_learned_query/modulations/latent_stats.npz",
  "modulation_variants": 4,
  "sample_posterior_latents": true,
  "validation_noise_seed": 0,
  "conditioning": null,
  "training_task": "diffusion",
  "init_from_checkpoint": "config/cod/stage2_transformer_diffusion_multiray21_learned_query/best.ckpt",
  "init_from_allowed_missing_prefixes": [
    "diffusion_model.model.slot_embedding"
  ],
  "CODVaeSpecs": {
    "checkpoint_path": "tmp/cod_vae_m32_weights.pt",
    "strict_checkpoint_loading": true,
    "checkpoint_allowed_missing_prefixes": [
      "autoencoder.latent_pos",
      "autoencoder.decoder.conv_refine."
    ],
    "use_learnable_positions": true,
    "latent_tokens": 32,
    "latent_dimension": 32,
    "embed_dimension": 512,
    "triplane_dimension": 32,
    "latent_decoder_layers": 12,
    "uncertainty_mode": "disabled",
    "encoder_params": {
      "num_patches": 512,
      "num_blocks": 4,
      "num_layers_per_block": 3
    },
    "decoder_params": {
      "output_resolution": 128,
      "output_patch_size": 8,
      "num_layers": 12,
      "num_init_layers": 1,
      "mlp_ratio": 2,
      "keep_ratio": 1.0,
      "num_merged_tokens": 8,
      "use_conv_refine": true
    }
  },
  "SdfModelSpecs": {"hidden_dim": 512, "feature_dim": 32},
  "diffusion_specs": {
    "sigma_data": 1.0,
    "P_mean": -1.2,
    "P_std": 1.2,
    "sigma_min": 0.002,
    "sigma_max": 80.0,
    "rho": 7.0,
    "sampling_steps": 40
  },
  "diffusion_model_specs": {
    "latent_tokens": 32,
    "latent_dimension": 32,
    "width": 256,
    "depth": 8,
    "heads": 8,
    "mlp_ratio": 4,
    "dropout": 0.25,
    "cond": false,
    "use_learnable_slot_embeddings": true
  },
  "learning_rates": {
    "diffusion": 0.00001,
    "diffusion_slot_embeddings": 0.0001
  },
  "lr_scheduler": {"type": "cosine", "min_lr": 0.000001, "epochs": 3000},
  "early_stopping": {
    "monitor": "val/loss",
    "mode": "min",
    "patience": 150,
    "min_delta": 0.00001
  },
  "weight_decay": 0.05,
  "gradient_clip_val": 1.0,
  "num_epochs": 3000,
  "log_freq": 200,
  "log_every_n_steps": 20
}
